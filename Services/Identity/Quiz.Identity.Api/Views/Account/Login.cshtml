@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth-card">
    <div class="eyebrow">Secure access</div>
    <h1>Welcome back</h1>
    <p class="lead">Sign in to continue your senior engineering practice.</p>

    <form asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="email" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="validation"></span>

        <label asp-for="Password">Password</label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="validation"></span>

        <label class="checkbox">
            <input asp-for="RememberMe" />
            <span>Keep me signed in</span>
        </label>

        <button type="submit">Sign in</button>
    </form>

    <p class="alternate">
        New to QuizApp?
        <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
    </p>
</section>

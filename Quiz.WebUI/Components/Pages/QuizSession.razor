@page "/quiz"
@inject IMediator Mediator
@inject ProtectedLocalStorage LocalStorage
@inject ILogger<QuizSession> Logger

<PageTitle>Тренировка — QuizApp</PageTitle>

<main class="session-page">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="session-container">
        @if (!isInitialized)
        {
            <div class="loading-state">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.body1">Готовим вашу тренировку...</MudText>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Class="mb-5">
                    @errorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Outlined"
                          Class="mb-5">
                    @successMessage
                </MudAlert>
            }

            @if (isResetConfirmationVisible)
            {
                <section class="reset-confirmation mb-5" aria-label="Подтверждение сброса прогресса">
                    <div>
                        <MudText Typo="Typo.h6">Сбросить весь прогресс?</MudText>
                        <MudText Typo="Typo.body2">
                            Все ваши сохранённые ответы будут удалены, и каждый вопрос снова станет доступен.
                        </MudText>
                    </div>
                    <div class="reset-confirmation-actions">
                        <MudButton Variant="Variant.Text"
                                   Disabled="@isBusy"
                                   OnClick="CancelProgressReset">
                            Отмена
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Disabled="@isBusy"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   OnClick="ResetProgressAsync">
                            @(isBusy ? "Сбрасываем..." : "Да, сбросить")
                        </MudButton>
                    </div>
                </section>
            }

            @if (questions is null)
            {
                <header class="session-heading">
                    <MudText Typo="Typo.overline" Color="Color.Primary">
                        Новая сессия
                    </MudText>
                    <h1>Что тренируем сегодня?</h1>
                    <MudText Typo="Typo.body1">
                        Выберите направление. Мы случайно соберём пять вопросов,
                        которых вы ещё не проходили.
                    </MudText>
                </header>

                <MudGrid Spacing="3">
                    @foreach (var option in TopicOptions)
                    {
                        <MudItem xs="12" sm="6">
                            <MudPaper Elevation="0" Class="topic-card">
                                <div class="topic-card-header">
                                    <span class="topic-symbol @option.StyleClass">
                                        <MudIcon Icon="@option.Icon" />
                                    </span>
                                    <span class="topic-amount">Senior / Senior+</span>
                                </div>
                                <MudText Typo="Typo.h5">@option.Label</MudText>
                                <MudText Typo="Typo.body2" Class="topic-description">
                                    @option.Description
                                </MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Disabled="@isBusy"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(() => StartQuizAsync(option))">
                                    Выбрать тему
                                </MudButton>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                @if (isBusy)
                {
                    <div class="inline-loading">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Собираем вопросы...</MudText>
                    </div>
                }

                <div class="progress-management">
                    <MudText Typo="Typo.body2">
                        Хотите пройти уже изученные вопросы ещё раз?
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Disabled="@isBusy"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ShowProgressResetConfirmation">
                        Сбросить прогресс
                    </MudButton>
                </div>
            }
            else if (currentIndex >= questions.Count)
            {
                <MudPaper Elevation="0" Class="completion-card">
                    <span class="completion-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Large" />
                    </span>

                    <MudText Typo="Typo.overline" Color="Color.Success">
                        Сессия завершена
                    </MudText>
                    <h1>
                        @(questions.Count == 0
                            ? "Здесь всё пройдено"
                            : $"Отличная работа: {questions.Count} из {questions.Count}")
                    </h1>
                    <MudText Typo="Typo.body1">
                        @(questions.Count == 0
                            ? "Вы уже ответили на все вопросы этой темы. Выберите другое направление или сбросьте прогресс."
                            : "Ваши ответы сохранены. Можно продолжить эту же тему или выбрать новое направление.")
                    </MudText>

                    <div class="completion-actions">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="Restart">
                            Продолжить тренировку
                        </MudButton>
                        <MudButton Href="/"
                                   Variant="Variant.Text"
                                   Size="Size.Large">
                            На главную
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ShowProgressResetConfirmation">
                            Сбросить прогресс
                        </MudButton>
                    </div>
                </MudPaper>
            }
            else
            {
                <div class="session-progress">
                    <div class="progress-copy">
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Primary">
                                @selectedTopicLabel
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Вопрос @(currentIndex + 1) из @questions.Count
                            </MudText>
                        </div>
                        <span>@Math.Round(ProgressPercent)%</span>
                    </div>
                    <MudProgressLinear Value="@ProgressPercent"
                                       Color="Color.Primary"
                                       Rounded="true"
                                       Size="Size.Medium" />
                </div>

                @if (idealAnswer is null)
                {
                    <MudPaper Elevation="0" Class="question-card">
                        <div class="question-number">0@(currentIndex + 1)</div>
                        <MudText Typo="Typo.h4" Class="question-text">
                            @questions[currentIndex].Text
                        </MudText>
                        <MudText Typo="Typo.body2" Class="question-hint">
                            Отвечайте так, как объясняли бы решение на техническом интервью.
                        </MudText>

                        <MudTextField @bind-Value="currentAnswer"
                                      Label="Ваш ответ"
                                      Placeholder="Сформулируйте основные идеи, компромиссы и примеры..."
                                      Variant="Variant.Outlined"
                                      Lines="9"
                                      Immediate="true"
                                      FullWidth="true"
                                      Disabled="@isBusy"
                                      Class="answer-input" />

                        <div class="question-actions">
                            <MudText Typo="Typo.caption">
                                Эталон откроется после сохранения ответа
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Disabled="@(isBusy || string.IsNullOrWhiteSpace(currentAnswer))"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="SubmitAnswerAsync">
                                @(isBusy ? "Сохраняем..." : "Показать эталон")
                            </MudButton>
                        </div>
                    </MudPaper>
                }
                else
                {
                    <div class="review-heading">
                        <span class="review-badge">
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                            Режим самопроверки
                        </span>
                        <MudText Typo="Typo.h4">Сравните ход мыслей</MudText>
                    </div>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Class="review-card user-answer-card">
                                <MudText Typo="Typo.overline">Ваш ответ</MudText>
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.body1" Class="answer-text">
                                    @currentAnswer
                                </MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Class="review-card ideal-answer-card">
                                <MudText Typo="Typo.overline" Color="Color.Success">
                                    Эталонный ответ
                                </MudText>
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.body1" Class="answer-text">
                                    @idealAnswer
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <div class="review-actions">
                        <MudText Typo="Typo.body2">
                            Отметьте для себя, какие аргументы стоит добавить в следующий раз.
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Large"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="NextQuestion">
                            @(currentIndex + 1 == questions.Count
                                ? "Завершить сессию"
                                : "Следующий вопрос")
                        </MudButton>
                    </div>
                }
            }
        }
    </MudContainer>
</main>

@code {
    private const string UserIdStorageKey = "quiz-app-user-id";

    private static readonly TopicOption[] TopicOptions =
    [
        new(Topic.CSharp, "C#", "Язык, CLR, память и асинхронность", Icons.Material.Filled.Code, "violet"),
        new(Topic.EntityFramework, "Entity Framework", "Запросы, tracking и работа с данными", Icons.Material.Filled.Storage, "blue"),
        new(Topic.RabbitMQ, "RabbitMQ", "Очереди, доставка и отказоустойчивость", Icons.Material.Filled.Hub, "orange"),
        new(Topic.PostgreSQL, "PostgreSQL", "Индексы, транзакции и оптимизация", Icons.Material.Filled.Dns, "green"),
        new(Topic.Architecture, "Architecture", "DDD, CQRS и системный дизайн", Icons.Material.Filled.AccountTree, "rose")
    ];

    private List<QuizQuestionDto>? questions;
    private int currentIndex;
    private string currentAnswer = string.Empty;
    private string? idealAnswer;
    private string? userId;
    private string? selectedTopicLabel;
    private string? errorMessage;
    private string? successMessage;
    private bool isBusy;
    private bool isInitialized;
    private bool isResetConfirmationVisible;

    private double ProgressPercent =>
        questions is null || questions.Count == 0
            ? 0
            : (currentIndex + 1d) / questions.Count * 100d;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var storedUserId = await LocalStorage
                .GetAsync<string>(UserIdStorageKey);

            if (storedUserId.Success &&
                Guid.TryParse(storedUserId.Value, out var parsedUserId))
            {
                userId = parsedUserId.ToString();
            }
            else
            {
                userId = Guid.NewGuid().ToString();
                await LocalStorage.SetAsync(UserIdStorageKey, userId);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Could not access protected local storage. Using a circuit-scoped user identifier.");

            userId = Guid.NewGuid().ToString();
        }
        finally
        {
            isInitialized = true;
            StateHasChanged();
        }
    }

    private async Task StartQuizAsync(TopicOption option)
    {
        if (userId is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;
        isResetConfirmationVisible = false;

        try
        {
            questions = (await Mediator.Send(
                new GetQuizBatchQuery(userId, option.Topic)))
                .ToList();

            selectedTopicLabel = option.Label;
            currentIndex = 0;
            currentAnswer = string.Empty;
            idealAnswer = null;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to start a quiz session.");
            errorMessage = "Не удалось загрузить вопросы. Попробуйте ещё раз.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SubmitAnswerAsync()
    {
        if (userId is null ||
            questions is null ||
            currentIndex >= questions.Count ||
            string.IsNullOrWhiteSpace(currentAnswer))
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await Mediator.Send(
                new SubmitAnswerCommand(
                    userId,
                    questions[currentIndex].Id,
                    currentAnswer));

            idealAnswer = result.IdealAnswer;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to submit a quiz answer.");
            errorMessage = "Не удалось сохранить ответ. Попробуйте ещё раз.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void NextQuestion()
    {
        currentAnswer = string.Empty;
        idealAnswer = null;
        currentIndex++;
        errorMessage = null;
    }

    private void Restart()
    {
        questions = null;
        currentIndex = 0;
        currentAnswer = string.Empty;
        idealAnswer = null;
        selectedTopicLabel = null;
        errorMessage = null;
        successMessage = null;
        isResetConfirmationVisible = false;
    }

    private void ShowProgressResetConfirmation()
    {
        errorMessage = null;
        successMessage = null;
        isResetConfirmationVisible = true;
    }

    private void CancelProgressReset()
    {
        isResetConfirmationVisible = false;
    }

    private async Task ResetProgressAsync()
    {
        if (userId is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            var deletedAnswers = await Mediator.Send(
                new ResetQuizProgressCommand(userId));

            questions = null;
            currentIndex = 0;
            currentAnswer = string.Empty;
            idealAnswer = null;
            selectedTopicLabel = null;
            isResetConfirmationVisible = false;
            successMessage = deletedAnswers == 0
                ? "Прогресс уже был пуст — все вопросы доступны."
                : $"Прогресс сброшен. Удалено ответов: {deletedAnswers}. Все вопросы снова доступны.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to reset quiz progress.");
            errorMessage = "Не удалось сбросить прогресс. Попробуйте ещё раз.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed record TopicOption(
        Topic Topic,
        string Label,
        string Description,
        string Icon,
        string StyleClass);
}

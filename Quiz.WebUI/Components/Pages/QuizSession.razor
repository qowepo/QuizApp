@page "/quiz"
@inject IMediator Mediator
@inject ProtectedLocalStorage LocalStorage
@inject ILogger<QuizSession> Logger

<PageTitle>Тренировка — QuizApp</PageTitle>

<main class="session-page">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="session-container">
        @if (!isInitialized)
        {
            <div class="loading-state">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.body1">Готовим вашу тренировку...</MudText>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Class="mb-5">
                    @errorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Outlined"
                          Class="mb-5">
                    @successMessage
                </MudAlert>
            }

            @if (isResetConfirmationVisible)
            {
                <section class="reset-confirmation mb-5" aria-label="Подтверждение сброса прогресса">
                    <div>
                        <MudText Typo="Typo.h6">Сбросить весь прогресс?</MudText>
                        <MudText Typo="Typo.body2">
                            Все ваши сохранённые ответы будут удалены, и каждый вопрос снова станет доступен.
                        </MudText>
                    </div>
                    <div class="reset-confirmation-actions">
                        <MudButton Variant="Variant.Text"
                                   Disabled="@isBusy"
                                   OnClick="CancelProgressReset">
                            Отмена
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Disabled="@isBusy"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   OnClick="ResetProgressAsync">
                            @(isBusy ? "Сбрасываем..." : "Да, сбросить")
                        </MudButton>
                    </div>
                </section>
            }

            @if (questions is null)
            {
                <header class="session-heading">
                    <MudText Typo="Typo.overline" Color="Color.Primary">
                        Новая сессия
                    </MudText>
                    <h1>Что тренируем сегодня?</h1>
                    <MudText Typo="Typo.body1">
                        Выберите направление. Мы случайно соберём десять непройденных вопросов
                        уровней Middle, Middle+, Senior и Senior+.
                    </MudText>
                </header>

                <MudGrid Spacing="3">
                    @foreach (var option in TopicOptions)
                    {
                        <MudItem xs="12" sm="6">
                            <MudPaper Elevation="0" Class="topic-card">
                                <div class="topic-card-header">
                                    <span class="topic-symbol @option.StyleClass">
                                        <MudIcon Icon="@option.Icon" />
                                    </span>
                                    <span class="topic-amount">10 вопросов · 4 уровня</span>
                                </div>
                                <MudText Typo="Typo.h5">@option.Label</MudText>
                                <MudText Typo="Typo.body2" Class="topic-description">
                                    @option.Description
                                </MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Disabled="@isBusy"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(() => StartQuizAsync(option))">
                                    Выбрать тему
                                </MudButton>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                @if (isBusy)
                {
                    <div class="inline-loading">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Собираем вопросы...</MudText>
                    </div>
                }

                <div class="progress-management">
                    <MudText Typo="Typo.body2">
                        Хотите пройти уже изученные вопросы ещё раз?
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Disabled="@isBusy"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ShowProgressResetConfirmation">
                        Сбросить прогресс
                    </MudButton>
                </div>
            }
            else if (currentIndex >= questions.Count)
            {
                <MudPaper Elevation="0" Class="completion-card">
                    <span class="completion-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Large" />
                    </span>

                    <MudText Typo="Typo.overline" Color="Color.Success">
                        Сессия завершена
                    </MudText>
                    <h1>
                        @(questions.Count == 0
                            ? "Здесь всё пройдено"
                            : $"Результат: {correctAnswers} из {questions.Count}")
                    </h1>
                    <MudText Typo="Typo.body1">
                        @(questions.Count == 0
                            ? "Вы уже ответили на все вопросы этой темы. Выберите другое направление или сбросьте прогресс."
                            : "Ваши ответы сохранены. Можно продолжить эту же тему или выбрать новое направление.")
                    </MudText>

                    <div class="completion-actions">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="Restart">
                            Продолжить тренировку
                        </MudButton>
                        <MudButton Href="/"
                                   Variant="Variant.Text"
                                   Size="Size.Large">
                            На главную
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ShowProgressResetConfirmation">
                            Сбросить прогресс
                        </MudButton>
                    </div>
                </MudPaper>
            }
            else
            {
                <div class="session-progress">
                    <div class="progress-copy">
                        <div>
                            <div class="question-meta">
                                <MudText Typo="Typo.overline" Color="Color.Primary">
                                    @selectedTopicLabel
                                </MudText>
                                <span class="difficulty-badge @GetDifficultyClass(CurrentQuestion.Difficulty)">
                                    @GetDifficultyLabel(CurrentQuestion.Difficulty)
                                </span>
                            </div>
                            <MudText Typo="Typo.body2">
                                Вопрос @(currentIndex + 1) из @questions.Count
                            </MudText>
                        </div>
                        <span>@Math.Round(ProgressPercent)%</span>
                    </div>
                    <MudProgressLinear Value="@ProgressPercent"
                                       Color="Color.Primary"
                                       Rounded="true"
                                       Size="Size.Medium" />
                </div>

                <MudPaper Elevation="0" Class="question-card">
                    <div class="question-number">@((currentIndex + 1).ToString("00"))</div>
                    @if (IsCodeAnalysisQuestion)
                    {
                        <pre class="question-text code-question">@CurrentQuestion.Text</pre>
                    }
                    else
                    {
                        <MudText Typo="Typo.h4" Class="question-text">
                            @CurrentQuestion.Text
                        </MudText>
                    }
                    <MudText Typo="Typo.body2" Class="question-hint">
                        Выберите наиболее точный ответ. После выбора изменить его будет нельзя.
                    </MudText>

                    <div class="answer-options" role="group" aria-label="Варианты ответа">
                        @for (var optionIndex = 0;
                              optionIndex < CurrentQuestion.Options.Count;
                              optionIndex++)
                        {
                            var option = CurrentQuestion.Options[optionIndex];
                            var review = GetOptionReview(option.Id);

                            <button type="button"
                                    class="answer-option @GetAnswerOptionClass(option.Id, review)"
                                    disabled="@(isBusy || answerResult is not null)"
                                    @onclick="@(() => SelectAnswerAsync(option.Id))">
                                <span class="option-letter">@GetOptionLetter(optionIndex)</span>
                                <span class="option-content">
                                    <span class="option-text">@option.Text</span>
                                    @if (review is not null)
                                    {
                                        <span class="option-explanation">
                                            @review.Explanation
                                        </span>
                                    }
                                </span>
                                @if (review?.IsCorrect == true)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                             Class="option-status-icon" />
                                }
                                else if (review is not null)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                             Class="option-status-icon" />
                                }
                            </button>
                        }
                    </div>

                    @if (isBusy)
                    {
                        <div class="answer-checking">
                            <MudProgressCircular Indeterminate="true"
                                                 Color="Color.Primary"
                                                 Size="Size.Small" />
                            <MudText Typo="Typo.body2">Проверяем ответ...</MudText>
                        </div>
                    }
                </MudPaper>

                @if (answerResult is not null)
                {
                    <section class="answer-review @(
                                 answerResult.IsCorrect
                                     ? "correct-review"
                                     : "incorrect-review")">
                        <div class="review-result">
                            <span class="review-result-icon">
                                <MudIcon Icon="@(answerResult.IsCorrect
                                                  ? Icons.Material.Filled.Check
                                                  : Icons.Material.Filled.Close)" />
                            </span>
                            <div>
                                <MudText Typo="Typo.overline">
                                    @(answerResult.IsCorrect
                                        ? "Верный ответ"
                                        : "Ответ неверный")
                                </MudText>
                                <MudText Typo="Typo.h5">
                                    @(answerResult.IsCorrect
                                        ? "Отлично — логика выбрана правильно."
                                        : "Посмотрите разбор и сравните варианты.")
                                </MudText>
                            </div>
                        </div>

                        <MudDivider Class="my-4" />

                        <MudText Typo="Typo.overline">
                            Подробное объяснение
                        </MudText>
                        <MudText Typo="Typo.body1" Class="detailed-explanation">
                            @answerResult.DetailedExplanation
                        </MudText>
                    </section>

                    <div class="review-actions">
                        <MudText Typo="Typo.body2">
                            Красным отмечены отвлекающие варианты, зелёным — правильный.
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="NextQuestion">
                            @(currentIndex + 1 == questions.Count
                                ? "Завершить сессию"
                                : "Следующий вопрос")
                        </MudButton>
                    </div>
                }
            }
        }
    </MudContainer>
</main>

@code {
    private const string UserIdStorageKey = "quiz-app-user-id";

    private static readonly TopicOption[] TopicOptions =
    [
        new(Topic.CSharp, "C#", "Язык, CLR, память и асинхронность", Icons.Material.Filled.Code, "violet"),
        new(Topic.EntityFramework, "Entity Framework", "Запросы, tracking и работа с данными", Icons.Material.Filled.Storage, "blue"),
        new(Topic.RabbitMQ, "RabbitMQ", "Очереди, доставка и отказоустойчивость", Icons.Material.Filled.Hub, "orange"),
        new(Topic.PostgreSQL, "PostgreSQL", "Индексы, транзакции и оптимизация", Icons.Material.Filled.Dns, "green"),
        new(Topic.Architecture, "Architecture", "DDD, CQRS и системный дизайн", Icons.Material.Filled.AccountTree, "rose")
    ];

    private List<QuizQuestionDto>? questions;
    private int currentIndex;
    private Guid? selectedOptionId;
    private SubmitAnswerResult? answerResult;
    private int correctAnswers;
    private string? userId;
    private string? selectedTopicLabel;
    private string? errorMessage;
    private string? successMessage;
    private bool isBusy;
    private bool isInitialized;
    private bool isResetConfirmationVisible;

    private double ProgressPercent =>
        questions is null || questions.Count == 0
            ? 0
            : (currentIndex + 1d) / questions.Count * 100d;

    private QuizQuestionDto CurrentQuestion =>
        questions![currentIndex];

    private bool IsCodeAnalysisQuestion =>
        CurrentQuestion.Text.Contains('\n');

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var storedUserId = await LocalStorage
                .GetAsync<string>(UserIdStorageKey);

            if (storedUserId.Success &&
                Guid.TryParse(storedUserId.Value, out var parsedUserId))
            {
                userId = parsedUserId.ToString();
            }
            else
            {
                userId = Guid.NewGuid().ToString();
                await LocalStorage.SetAsync(UserIdStorageKey, userId);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Could not access protected local storage. Using a circuit-scoped user identifier.");

            userId = Guid.NewGuid().ToString();
        }
        finally
        {
            isInitialized = true;
            StateHasChanged();
        }
    }

    private async Task StartQuizAsync(TopicOption option)
    {
        if (userId is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;
        isResetConfirmationVisible = false;

        try
        {
            questions = (await Mediator.Send(
                new GetQuizBatchQuery(userId, option.Topic)))
                .ToList();

            selectedTopicLabel = option.Label;
            currentIndex = 0;
            selectedOptionId = null;
            answerResult = null;
            correctAnswers = 0;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to start a quiz session.");
            errorMessage = "Не удалось загрузить вопросы. Попробуйте ещё раз.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SelectAnswerAsync(Guid answerOptionId)
    {
        if (userId is null ||
            questions is null ||
            currentIndex >= questions.Count ||
            answerResult is not null ||
            isBusy)
        {
            return;
        }

        selectedOptionId = answerOptionId;
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await Mediator.Send(
                new SubmitAnswerCommand(
                    userId,
                    questions[currentIndex].Id,
                    answerOptionId));

            answerResult = result;

            if (result.IsCorrect)
            {
                correctAnswers++;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to submit a quiz answer.");
            errorMessage = "Не удалось сохранить ответ. Попробуйте ещё раз.";
            selectedOptionId = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void NextQuestion()
    {
        selectedOptionId = null;
        answerResult = null;
        currentIndex++;
        errorMessage = null;
    }

    private void Restart()
    {
        questions = null;
        currentIndex = 0;
        selectedOptionId = null;
        answerResult = null;
        correctAnswers = 0;
        selectedTopicLabel = null;
        errorMessage = null;
        successMessage = null;
        isResetConfirmationVisible = false;
    }

    private void ShowProgressResetConfirmation()
    {
        errorMessage = null;
        successMessage = null;
        isResetConfirmationVisible = true;
    }

    private void CancelProgressReset()
    {
        isResetConfirmationVisible = false;
    }

    private async Task ResetProgressAsync()
    {
        if (userId is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            var deletedAnswers = await Mediator.Send(
                new ResetQuizProgressCommand(userId));

            questions = null;
            currentIndex = 0;
            selectedOptionId = null;
            answerResult = null;
            correctAnswers = 0;
            selectedTopicLabel = null;
            isResetConfirmationVisible = false;
            successMessage = deletedAnswers == 0
                ? "Прогресс уже был пуст — все вопросы доступны."
                : $"Прогресс сброшен. Удалено ответов: {deletedAnswers}. Все вопросы снова доступны.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to reset quiz progress.");
            errorMessage = "Не удалось сбросить прогресс. Попробуйте ещё раз.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private AnswerOptionReviewDto? GetOptionReview(Guid optionId)
    {
        return answerResult?.Options.SingleOrDefault(
            option => option.Id == optionId);
    }

    private string GetAnswerOptionClass(
        Guid optionId,
        AnswerOptionReviewDto? review)
    {
        if (review is null)
        {
            return selectedOptionId == optionId
                ? "selected pending"
                : string.Empty;
        }

        var resultClass = review.IsCorrect ? "correct" : "incorrect";
        var selectedClass = selectedOptionId == optionId ? " selected" : string.Empty;

        return resultClass + selectedClass;
    }

    private static char GetOptionLetter(int index)
    {
        return (char)('A' + index);
    }

    private static string GetDifficultyLabel(Difficulty difficulty)
    {
        return difficulty switch
        {
            Difficulty.Middle => "Middle",
            Difficulty.MiddlePlus => "Middle+",
            Difficulty.Senior => "Senior",
            Difficulty.SeniorPlus => "Senior+",
            _ => difficulty.ToString()
        };
    }

    private static string GetDifficultyClass(Difficulty difficulty)
    {
        return difficulty switch
        {
            Difficulty.Middle => "middle",
            Difficulty.MiddlePlus => "middle-plus",
            Difficulty.Senior => "senior",
            Difficulty.SeniorPlus => "senior-plus",
            _ => string.Empty
        };
    }

    private sealed record TopicOption(
        Topic Topic,
        string Label,
        string Description,
        string Icon,
        string StyleClass);
}

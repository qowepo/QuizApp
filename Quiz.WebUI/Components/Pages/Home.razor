@page "/"

<PageTitle>QuizApp</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-12 text-center">
    <MudText Typo="Typo.h2" GutterBottom="true">
        Senior Developer Self-Assessment
    </MudText>
    <MudText Typo="Typo.h6" Class="mb-8">
        Практикуйте ответы на сложные вопросы и сравнивайте их с эталоном.
    </MudText>
    <MudButton Href="/quiz"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large">
        Начать квиз
    </MudButton>
</MudContainer>

@inherits LayoutComponentBase

<MudThemeProvider Theme="@theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="app-header">
        <div class="header-inner">
            <MudLink Href="/" Underline="Underline.None" Class="brand">
                <span class="brand-mark">Q</span>
                <span class="brand-copy">
                    <strong>QuizApp</strong>
                    <small>Senior practice lab</small>
                </span>
            </MudLink>

            <MudSpacer />

            <nav class="main-navigation" aria-label="Главная навигация">
                <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit">
                    Главная
                </MudButton>
                <MudButton Href="/quiz"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Bolt">
                    Тренировка
                </MudButton>
            </nav>
        </div>
    </MudAppBar>

    <MudMainContent Class="app-content">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Произошла ошибка.
    <a href="" class="reload">Перезагрузить</a>
    <a class="dismiss">×</a>
</div>

@code {
    private readonly MudTheme theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6557E8",
            Secondary = "#00A884",
            Success = "#159A68",
            Background = "#F5F6FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#17182A",
            TextPrimary = "#17182A",
            TextSecondary = "#686A7A"
        }
    };
}
